{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "docs",
  "functions": {"api/index.py": {"maxDuration": 30, "excludeFiles": "{reports/**,tests/**,.git/**}"}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api?route=:path*"}],
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "X-Robots-Tag", "value": "noindex"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}]}
  ]
}
